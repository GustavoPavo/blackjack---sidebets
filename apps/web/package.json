{
  "name": "@bj/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p . && vite build",
    "test": "vitest run",
    "typecheck": "tsc -p .",
    "cap:check:development": "node scripts/check-native-env.mjs native-development",
    "cap:check:test": "node scripts/check-native-env.mjs native-test",
    "cap:check:production": "node scripts/check-native-env.mjs native-production",
    "build:native:development": "npm run cap:check:development && tsc -p . && vite build --mode native-development && CAP_ENV=development cap sync",
    "build:native:test": "npm run cap:check:test && tsc -p . && vite build --mode native-test && CAP_ENV=test cap sync",
    "build:native:production": "npm run cap:check:production && tsc -p . && vite build --mode native-production && CAP_ENV=production cap sync",
    "cap:add:android": "cap add android",
    "cap:add:ios": "cap add ios",
    "cap:open:android": "cap open android",
    "cap:open:ios": "cap open ios",
    "cap:run:android": "cap run android",
    "assets:generate": "capacitor-assets generate --iconBackgroundColor '#06291e' --iconBackgroundColorDark '#06291e' --splashBackgroundColor '#06291e' --splashBackgroundColorDark '#06291e'"
  },
  "dependencies": {
    "@bj/engine": "*",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "jsdom": "^25.0.0",
    "vite": "^5.4.0"
  }
}
